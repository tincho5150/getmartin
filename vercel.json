{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/truck-loader",
      "status": 308,
      "headers": { "Location": "/work/truck-loader" }
    },
    {
      "src": "/proof",
      "status": 308,
      "headers": { "Location": "/work" }
    },
    {
      "src": "/proof/(.*)",
      "status": 308,
      "headers": { "Location": "/work/$1" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
