{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/truck-loader",
      "status": 308,
      "headers": {
        "Location": "/proof/truck-loader"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
